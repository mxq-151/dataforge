;; DataForge — opencode macOS Seatbelt 沙箱配置
;;
;; 由 electron/backend/opencode.ts 在启动 opencode 进程时自动套用：
;;   sandbox-exec -f opencode-macos.sb \
;;     -D PROJECT="$CWD" -D HOME="$HOME" -D TMPDIR="$TMPDIR" \
;;     -D JAVA_HOME="$JAVA_HOME" -D MAVEN_HOME="$MAVEN_HOME" \
;;     -D SCALA_HOME="$SCALA_HOME" -D OPENCODE_BIN_DIR="$OPENCE_BIN_DIR" \
;;     -D USERNAME="$USERNAME" -D GITREPO="$GITREPO" \
;;     -- $OPENCE_BIN serve --hostname=127.0.0.1 --port=4096 ...
;;
;; 设计目标
;; ---------
;; - 限制 opencode 进程及其所有子进程（git / java / python / mvn / npm / bash 等）
;;   的文件【写】范围到实际工作目录与必要的 opencode 运行时目录，拒绝写入系统目录与
;;   HOME 下其他位置，防止失控的 agent 篡改系统或凭据。
;; - 限制【进程执行】到系统工具链、项目内脚本与用户配置的工具链目录，禁止高危
;;   启动器 / 提权 / GUI 桥接二进制。
;; - 限制文件【读】范围为白名单：与 opencode 服务端 permission.external_directory=deny
;;   语义一致，agent 无法读取工作目录之外的用户数据（源码、文档、凭据、其他后端目录等）。
;;   工作目录边界用 regex 锚定到 {PROJECT}(hostBase) 下该登录用户实际使用的工作子树
;;   （{PROJECT}/code、{PROJECT}/{username}、{PROJECT}/{gitRepoDirName}），而非常规的整块
;;   hostBase 放行，从而排除兄弟项目与其它用户的数据。白名单仍放行：系统运行库、
;;   实际工作目录、工具链、opencode 自身运行时、构建依赖缓存、临时目录，以及 git SSH 所需文件。
;; - 纵深防御：显式屏蔽敏感凭据目录（.ssh 私钥、.aws、.gnupg、gcloud、kube）的【读】权限，
;;   但保留 .ssh/config 与 known_hosts 以便 git SSH 可用。
;; - 【网络保持开放】：opencode 必须联网调用模型 API，且 serve 仅监听 127.0.0.1，
;;   sandbox-exec 无法按域名做白名单（那需要额外本地代理），故出站网络不限制。
;;
;; 注：sandbox-exec 已被 Apple 标记为 deprecated，但在 macOS 15 仍可用。
;;     所有 -D 变量必须由调用方保证非空（主进程已做 fallback），否则 subpath ""
;;     会错误地匹配文件系统根。

(version 1)

;; 基线：允许一切，再逐步收紧
(allow default)

;; ───────────────────────────────────────────────────────────────
;; 写：默认拒绝，仅放行工作目录与必要的运行时目录
;; ───────────────────────────────────────────────────────────────
(deny file-write*)

;; 实际工作目录（核心可写区）—— 从整块 hostBase(PROJECT) 收紧到实际工作子树：
;; code/{pc} 源码根、{username}/individual 会话、{gitRepoDirName}/ git 仓库、opencode 运行时。
;; 逐条 subpath 放行，防止 agent 越界写兄弟项目/他人数据。
(allow file-write* (subpath (string-append (param "PROJECT") "/code")))
(allow file-write* (subpath (string-append (param "PROJECT") "/" (param "USERNAME"))))
(allow file-write* (subpath (string-append (param "PROJECT") "/" (param "GITREPO"))))
(allow file-write* (subpath (string-append (param "PROJECT") "/.opencode")))
(allow file-write* (subpath (string-append (param "PROJECT") "/.local")))

;; opencode 自身运行时数据（会话 SQLite、缓存、配置、XDG 状态/锁）
(allow file-write* (subpath (string-append (param "HOME") "/.local/share/opencode")))
(allow file-write* (subpath (string-append (param "HOME") "/.local/state/opencode")))
(allow file-write* (subpath (string-append (param "HOME") "/.config/opencode")))
(allow file-write* (subpath (string-append (param "HOME") "/.cache/opencode")))
(allow file-write* (subpath (string-append (param "HOME") "/.opencode")))

;; 临时目录（构建产物、进程间通信、日志）
(allow file-write* (subpath "/tmp"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath (param "TMPDIR")))
;; macOS per-user 临时目录：$TMPDIR 形如 /var/folders/xx/.../T，
;; 其中 /var 是指向 /private/var 的符号链接。sandbox-exec 处理文件路径时会进行
;; 符号链接解析，subpath 需要匹配解析后的真实路径 /private/var/folders，
;; 否则 opencode 尝试在临时目录创建目录时报 EPERM (operation not permitted)。
(allow file-write* (subpath "/private/var/folders"))

;; ───────────────────────────────────────────────────────────────
;; 读：不设全局 deny file-read*
;; 曾尝试白名单模式（默认拒绝读，仅放行工作目录与系统运行库），但全局
;; deny file-read* 会使 opencode 二进制在 sandbox-exec 下 SIGABRT（exit 134）：
;; 运行时仍需读取未枚举的系统文件（dyld 共享缓存、/dev、/etc 等）。
;; 故读侧边界交由 opencode 服务端 permission.external_directory=deny 控制，
;; 沙箱侧仅保留下方凭据黑名单与路径放行，作为纵深防御。
;; 注意 seatbelt 求值为“后匹配者优先”，凭据 deny 须在具体例外 allow 之前，
;; 方可既屏蔽私钥又保留 git SSH 所需文件。
;; ───────────────────────────────────────────────────────────────

;; 实际工作目录（agent 可读核心区）—— 从整块 hostBase 收紧到该登录用户实际工作子树：
;; code/{pc}、{username}/individual、{gitRepoDirName}/、opencode 运行时。逐条 subpath，
;; 排除兄弟项目与其它用户数据。注：seatbelt 的 regex filter 在本机 sandbox-exec 初始化时
;; 会 abort（SIGABRT），故此处用受支持的 subpath 精确列出各工作目录。
(allow file-read* (subpath (string-append (param "PROJECT") "/code")))
(allow file-read* (subpath (string-append (param "PROJECT") "/" (param "USERNAME"))))
(allow file-read* (subpath (string-append (param "PROJECT") "/" (param "GITREPO"))))
(allow file-read* (subpath (string-append (param "PROJECT") "/.opencode")))
(allow file-read* (subpath (string-append (param "PROJECT") "/.local")))

;; 注：仅放行 {PROJECT} 根目录自身的元数据（opencode 的 cwd 即 hostBase，必须能 stat 自身），
;; 该规则只授予该目录的 stat/readdir，既不读任何子目录内容，也读不到兄弟项目/他人数据。
(allow file-read-metadata (literal (param "PROJECT")))

;; 系统运行库：二进制、动态库、启动器、证书、网络解析等（opencode/JVM 运行必需）
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/opt"))
(allow file-read* (subpath "/dev"))
(allow file-read* (subpath "/etc"))
(allow file-read* (subpath "/private/var"))

;; 工具链目录（JAVA / MAVEN / SCALA / opencode 二进制）
(allow file-read* (subpath (param "JAVA_HOME")))
(allow file-read* (subpath (param "MAVEN_HOME")))
(allow file-read* (subpath (param "SCALA_HOME")))
(allow file-read* (subpath (param "OPENCODE_BIN_DIR")))

;; opencode 自身运行时数据（会话 SQLite、配置、授权、缓存）
(allow file-read* (subpath (string-append (param "HOME") "/.local/share/opencode")))
(allow file-read* (subpath (string-append (param "HOME") "/.local/state/opencode")))
(allow file-read* (subpath (string-append (param "HOME") "/.config/opencode")))
(allow file-read* (subpath (string-append (param "HOME") "/.cache/opencode")))
(allow file-read* (subpath (string-append (param "HOME") "/.opencode")))

;; 构建 / 依赖缓存：Java/Scala 编译与 Metals/coursier 依赖拉取运行必需
(allow file-read* (subpath (string-append (param "HOME") "/.m2")))
(allow file-read* (subpath (string-append (param "HOME") "/.ivy2")))
(allow file-read* (subpath (string-append (param "HOME") "/.cache")))
(allow file-read* (subpath (string-append (param "HOME") "/.gradle")))
(allow file-read* (subpath (string-append (param "HOME") "/Library/Caches")))

;; git 全局配置与凭证（agent 提交 / 拉取必需）
(allow file-read* (literal (string-append (param "HOME") "/.gitconfig")))
(allow file-read* (literal (string-append (param "HOME") "/.git-credentials")))

;; 临时目录（进程间通信、日志、构建产物）
(allow file-read* (subpath "/tmp"))
(allow file-read* (subpath "/private/tmp"))
(allow file-read* (subpath (param "TMPDIR")))
(allow file-read* (subpath "/private/var/folders"))

;; ── 纵深防御：显式屏蔽敏感凭据目录（在 git SSH 例外 allow 之前）──
(deny file-read* (subpath (string-append (param "HOME") "/.ssh")))
(deny file-read* (subpath (string-append (param "HOME") "/.aws")))
(deny file-read* (subpath (string-append (param "HOME") "/.gnupg")))
(deny file-read* (subpath (string-append (param "HOME") "/.config/gcloud")))
(deny file-read* (subpath (string-append (param "HOME") "/.kube")))
;; git SSH 需要的非敏感文件例外放行（须排在对 .ssh 的整体 deny 之后）
(allow file-read* (literal (string-append (param "HOME") "/.ssh/config")))
(allow file-read* (literal (string-append (param "HOME") "/.ssh/known_hosts")))

;; ───────────────────────────────────────────────────────────────
;; 进程执行：默认拒绝，仅放行工具链
;; ───────────────────────────────────────────────────────────────
(deny process-exec)

(allow process-exec (subpath "/bin"))
(allow process-exec (subpath "/usr/bin"))
(allow process-exec (subpath "/usr/local/bin"))
(allow process-exec (subpath "/usr/lib"))
(allow process-exec (subpath "/System"))
(allow process-exec (subpath "/Library"))
(allow process-exec (subpath "/opt/homebrew"))
(allow process-exec (subpath "/opt/local"))
(allow process-exec (subpath "/opt"))
(allow process-exec (subpath "/Library/Java"))
(allow process-exec (subpath "/usr/local"))
(allow process-exec (subpath "/private/var"))

;; 用户配置的工具链（动态传入，空则忽略）
(allow process-exec (subpath (param "JAVA_HOME")))
(allow process-exec (subpath (param "MAVEN_HOME")))
(allow process-exec (subpath (param "SCALA_HOME")))

;; 项目内脚本
(allow process-exec (subpath (param "PROJECT")))

;; opencode 自身二进制目录（由主进程 -D OPENCODE_BIN_DIR 注入）。
;; 显式放行，确保无论 PROJECT/cwd 落在何处，opencode 进程及其直接加载均不被
;; process-exec 默认拒绝误伤（否则报 Operation not permitted）。
(allow process-exec (subpath (param "OPENCODE_BIN_DIR")))
(allow file-read*   (subpath (param "OPENCODE_BIN_DIR")))

;; 禁止高危启动器 / 提权 / GUI 桥接
(deny process-exec (literal "/usr/bin/osascript"))
(deny process-exec (literal "/usr/bin/open"))
(deny process-exec (literal "/usr/bin/sudo"))
(deny process-exec (literal "/bin/launchctl"))
(deny process-exec (literal "/usr/bin/askpass"))

;; ───────────────────────────────────────────────────────────────
;; 网络：保持开放（opencode 需调用模型 API；serve 仅监听 127.0.0.1）
;; 不添加 (deny network*) —— 出站网络允许
;; ───────────────────────────────────────────────────────────────
