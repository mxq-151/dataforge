<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.thesamet.scalapb</groupId>
    <artifactId>lenses_2.12</artifactId>
    <packaging>jar</packaging>
    <description>lenses</description>
    <url>https://github.com/scalapb/ScalaPB</url>
    <version>0.11.20</version>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>lenses</name>
    <organization>
        <name>com.thesamet.scalapb</name>
        <url>https://github.com/scalapb/ScalaPB</url>
    </organization>
    <scm>
        <url>https://github.com/scalapb/ScalaPB</url>
        <connection>scm:git:https://github.com/scalapb/ScalaPB.git</connection>
        <developerConnection>scm:git:git@github.com:scalapb/ScalaPB.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <id>thesamet</id>
            <name>Nadav Samet</name>
            <url>https://thesamet.com</url>
            <email>thesamet@gmail.com</email>
        </developer>
    </developers>
    <properties>
        <info.versionScheme>early-semver</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>2.12.20</version>
        </dependency>
        <dependency>
            <groupId>org.scala-lang.modules</groupId>
            <artifactId>scala-collection-compat_2.12</artifactId>
            <version>2.13.0</version>
        </dependency>
        <dependency>
            <groupId>org.scalameta</groupId>
            <artifactId>munit_2.12</artifactId>
            <version>1.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>Sonatype OSS Snapshots</id>
            <name>Sonatype OSS Snapshots</name>
            <url>https://oss.sonatype.org/content/repositories/snapshots/</url>
            <layout>default</layout>
        </repository>
    </repositories>
</project>