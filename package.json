{
  "name": "dataforge-electron",
  "version": "0.1.0",
  "description": "DataForge 基于 Electron 的重构版",
  "author": "DataForge",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "start": "electron .",
    "postinstall": "patch-package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.dataforge.electron",
    "productName": "DataForge",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sandbox",
        "to": "sandbox",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/metals",
        "to": "metals",
        "filter": [
          "coursier.jar"
        ]
      },
      {
        "from": "resources/jdtls",
        "to": "jdtls",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/binaries/opencode-aarch64-apple-darwin",
        "to": "binaries/opencode"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "electronLanguages": [
        "zh_CN",
        "zh_TW",
        "en"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "electronLanguages": [
        "zh-CN",
        "zh-TW",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "软件使用许可协议.txt",
      "installerIcon": "build/icon.png",
      "uninstallerIcon": "build/icon.png"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "^1.0.3",
    "@codingame/monaco-vscode-api": "^25.1.2",
    "@codingame/monaco-vscode-editor-api": "^25.1.2",
    "@codingame/monaco-vscode-extension-api": "^25.1.2",
    "@monaco-editor/react": "^4.7.0",
    "@opencode-ai/sdk": "^1.18.22",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/react": "^16.3.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@xyflow/react": "^12.11.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.34.0",
    "monaco-languageclient": "^10.7.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-file-navigator": "^1.0.2-dev.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@^25.1.2",
    "wait-on": "^9.1.0"
  }
}
