# Dependencies
node_modules/

# Build outputs (Vite renderer)
dist/
dist-ssr/
*.local

# Build outputs (Electron main process, tsc)
dist-electron/

# electron-builder packaged artifacts
release/
dist_electron/
electron-builder.yml

# Monaco cache
public/monaco

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment & secrets
.env
.env.*
!.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.projectile

# Bundled LSP servers（体积过大，不入库；构建/发布时从 resources/ 侧资源获取）
resources/metals/metals.jar
resources/metals/metals-1.6.8.jar.bak
resources/metals/coursier.jar
resources/binaries/

# Java test artifacts
**/*.class

# OS files
Thumbs.db

# AI 性能基准：浏览器临时 profile 与报告快照
.edge-bench-profile/
.edge-debug-profile/

# V8 CPU profile 采集用的浏览器临时 profile（Chrome）
.chrome-profile-bench/
# 原始 CPU profile（3~4MB/份，可按需重生成，不入库）
perf/*.raw.json

# 安装协议标记：运行时应落在 userData（旧实现写在仓库根/应用包内，不入库）
.df-install-token
