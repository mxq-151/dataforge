<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Electron（尤其 arm64）需要 JIT，否则启动即崩 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- 允许加载其他团队签名的框架。
	     Electron 自带的 framework 由 Electron 团队签名，与我们的证书 Team 不同，
	     启用 hardenedRuntime 后必须放行，否则应用无法启动。-->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- 允许携带 DYLD_* 环境变量：opencode / JDTLS / java 拉起子进程时需要 -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- 允许 JIT 写入可执行内存：Node/Electron V8 与 java 运行时需要 -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- 允许禁用可写页写保护：java / 运行时交叉编译场景兜底（宽松选项，可按需去掉） -->
	<key>com.apple.security.cs.disable-executable-page-protection</key>
	<true/>
	<!-- 声明出站网络访问：编译服务 / opencode / JDTLS 均需，公证要求显式声明 -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>